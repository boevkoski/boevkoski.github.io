# This file shows what environment variables you can use (optional)
# Create a .env.local file if you need environment variables
# .env.local is already in .gitignore so it won't be committed

# Example: Analytics tracking ID
# VITE_ANALYTICS_ID=your-id-here

# Example: Custom API endpoints (if needed in the future)
# VITE_API_URL=https://api.example.com
